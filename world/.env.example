# Browser client. Leave blank to use the local Phase 4 service.
VITE_FESTIVAL_SERVER_URL=http://127.0.0.1:8787

# Server. Replace the development key before any public launch.
FESTIVAL_HOST=127.0.0.1
FESTIVAL_PORT=8787
FESTIVAL_ADMIN_KEY=replace-before-production
FESTIVAL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Where STAFF settings are kept between restarts. Leave blank for
# server/festival-state.json, or use "off" for a throwaway instance that always
# boots from the built-in festival defaults.
FESTIVAL_STATE_FILE=

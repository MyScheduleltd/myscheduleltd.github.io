# Where the published BETA looks for the festival service.
#
# Vite reads this automatically for production builds, so `npm run build:beta`
# picks it up without anyone having to remember a flag. It holds no secret: it
# is a public address that ends up in the shipped bundle either way.
#
# This is the URL Render gives the service in render.yaml. If Render had to
# pick a different name because that one was taken, change it here and rebuild.
# Empty it to go back to single-player.
VITE_FESTIVAL_SERVER_URL=https://myschedule-festival.onrender.com
